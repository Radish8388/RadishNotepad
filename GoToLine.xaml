<Window x:Class="RadishNotepad.GoToLine"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RadishNotepad"
        mc:Ignorable="d"
        Title="Go To Line"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Line Number:" Margin="0,0,0,6" />
        <TextBox x:Name="LineNumberText" MinWidth="100" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Go To" IsDefault="True" MinWidth="60" Margin="0,0,15,0"
                    Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="60" />
        </StackPanel>
    </StackPanel>
</Window>
